# The Warlay server this build talks to. It is injected when the app is
# built and is NOT part of the source code.
#
# Local builds: copy this file to `.env` (git-ignored) and put your own
# server here, or export the variable in your shell.
# GitHub Actions: create a repository secret named WARLAY_MAIN_URL (in a fork,
# point it at your own server); the workflows pass it as VITE_WARLAY_MAIN_URL.
#
# A production build (`npm run build`, `npx tauri build`) fails without it;
# `npm run dev` falls back to http://127.0.0.1:8080.
VITE_WARLAY_MAIN_URL=https://warlay.example.com
