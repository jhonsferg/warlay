{
  "name": "warlay-client",
  "description": "Warlay desktop client: play Warcraft III LAN games over the internet, with friends, rooms and voice chat",
  "keywords": [
    "warcraft-3",
    "wc3",
    "lan",
    "multiplayer",
    "p2p",
    "quic",
    "voice-chat",
    "tauri",
    "vue"
  ],
  "homepage": "https://github.com/jhonsferg/warlay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonsferg/warlay.git"
  },
  "bugs": {
    "url": "https://github.com/jhonsferg/warlay/issues"
  },
  "license": "MIT",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "node --test src/services/*.test.ts",
    "tauri": "tauri",
    "build-portable-zip": "node scripts/build-portable-zip.mjs",
    "dist": "tauri build && npm run build-portable-zip"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@lucide/vue": "^1.68.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass": "^1.107.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
