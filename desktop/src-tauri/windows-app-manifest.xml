<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifesto de warlay.exe.

  Identico al que Tauri incrusta por defecto (tauri-build,
  windows-app-manifest.xml) salvo por requestedExecutionLevel, subido de
  asInvoker a requireAdministrator: este binario es a la vez el cliente de
  escritorio y el agente de red de Warlay, y el agente necesita Administrador
  para la captura cruda SIO_RCVALL. Un PE lleva un unico manifiesto, asi que
  la elevacion vale para todo el proceso, tambien para la instancia del
  agente que lanza el cliente: eso es lo que hace posible un unico binario
  distribuible.

  El detalle de por que vive en un fichero aparte esta en build.rs.

  NO quitar la dependencia de Common Controls v6: las APIs de dialogo de
  Tauri la necesitan (aviso en tauri_build::WindowsAttributes::app_manifest).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
