{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warlay",
  "version": "0.4.2",
  "identifier": "com.warlay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run prepare-daemon-sidecar",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Warlay",
        "width": 1000,
        "height": 700,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "transparent": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss: http: ws:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/wnetd"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
